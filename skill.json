{
  "name": "attract-signal",
  "version": "2.0.0",
  "description": "Portable Hermes/Codex/Claude skill for short-form and Reddit audience intelligence; adds precision-first relevance, semantic themes, saved audiences, alerts, dashboards, and evidence-linked content strategy while keeping Last30Days independently updateable.",
  "skill_path": "skills/media/attract-signal",
  "install_targets": {
    "hermes": "~/.hermes/skills/attract-signal",
    "codex": "~/.codex/skills/attract-signal",
    "claude": "~/.claude/skills/attract-signal"
  },
  "default_channel": "https://www.youtube.com/@_The_Clean_Girl/shorts",
  "requires": [
    "python3",
    "yt-dlp",
    "youtube-transcript-api"
  ],
  "scripts": [
    "skills/media/attract-signal/scripts/scan_shorts.py",
    "skills/media/attract-signal/scripts/import_platform.py",
    "skills/media/attract-signal/scripts/analyze_signals.py",
    "skills/media/attract-signal/scripts/analyze_reddit_conversations.py",
    "skills/media/attract-signal/scripts/reddit_intelligence.py",
    "skills/media/attract-signal/scripts/reddit_signal.py",
    "skills/media/attract-signal/scripts/evaluate_reddit_intelligence.py",
    "skills/media/attract-signal/scripts/generate_report.py",
    "skills/media/attract-signal/scripts/fetch_transcript.py",
    "skills/media/attract-signal/scripts/publish_doc.py",
    "skills/media/attract-signal/scripts/export_calendar_sheets.py",
    "skills/media/attract-signal/scripts/signal_library.py"
  ],
  "optional": [
    "gogcli",
    "openai"
  ]
}
